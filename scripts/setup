#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Bare `python3` resolves by PATH order, which on macOS reaches the system 3.9
# before Homebrew. Prefer the versions Home Assistant supports, newest first.
PYTHON=""
for candidate in python3.14 python3.13 python3
do
    if "$candidate" -c 'import sys
raise SystemExit(sys.version_info < (3, 13))' 2>/dev/null
    then
        PYTHON="$candidate"
        break
    fi
done

if [[ -z "$PYTHON" ]]
then
    echo "setup: need Python 3.13 or newer, found none on PATH" >&2
    exit 1
fi

"$PYTHON" -m venv .venv
.venv/bin/pip install --requirement requirements.txt
